#!/usr/bin/env python3
"""Brain OS deterministic maintenance CLI."""

from __future__ import annotations

import argparse
import json
import sys

from runtime.config import resolve_paths
from runtime.retrieval import RetrievalIndex


def _emit(value: object) -> None:
    print(json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True))


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="brain")
    parser.add_argument("--store", help="Brain Store path (or BRAIN_STORE_PATH)")
    parser.add_argument("--runtime", help="Runtime path (or BRAIN_RUNTIME_PATH)")
    parser.add_argument("--cache", help="Cache path (or BRAIN_CACHE_PATH)")
    commands = parser.add_subparsers(dest="command", required=True)
    index_parser = commands.add_parser("index", help="maintain the retrieval projection")
    index_parser.add_argument("action", choices=("status", "refresh", "rebuild", "migrate", "verify"))
    context_parser = commands.add_parser("context", help="retrieve compact context")
    context_parser.add_argument("query")
    context_parser.add_argument("--project", default="")
    context_parser.add_argument("--agent", default="local-cli")
    context_parser.add_argument("--mode", default="compact", choices=("compact", "fingerprints", "deep"))
    context_parser.add_argument("--max-context-units", type=int, default=1200)
    context_parser.add_argument("--context-handle", default="")
    evaluate_parser = commands.add_parser("evaluate", help="run a golden retrieval dataset")
    evaluate_parser.add_argument("dataset", nargs="?", default="evaluation/retrieval-golden.json")
    args = parser.parse_args(argv)
    paths = resolve_paths(args.store, args.runtime, args.cache)
    index = RetrievalIndex(paths.store, paths.retrieval_db, paths.cache)
    if args.command == "index":
        result = getattr(index, args.action)()
    elif args.command == "context":
        status = index.status()
        if not status["chunk_count"] or status["stale_file_count"]:
            index.refresh()
        result = index.context(
            args.query, project=args.project, agent=args.agent, mode=args.mode,
            max_context_units=args.max_context_units,
            context_handle=args.context_handle, caller_id="local-cli",
        )
    else:
        from runtime.retrieval.evaluation import evaluate
        status = index.status()
        if not status["chunk_count"] or status["stale_file_count"]:
            index.refresh()
        result = evaluate(index, args.dataset)
    _emit(result)
    return 0 if not isinstance(result, dict) or result.get("ok", True) else 1


if __name__ == "__main__":
    sys.exit(main())
